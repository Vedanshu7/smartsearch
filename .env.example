# LLM provider: openai | anthropic | gemini | groq (default: openai)
LLM_PROVIDER=openai

# Model override (optional, uses provider default if blank)
LLM_MODEL=

# API keys: provide the one matching your chosen LLM_PROVIDER
OPENAI_API_KEY=sk-proj-your-key-here
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Backend
PORT=8080

# Frontend (copy to smart-search/.env.local for local dev)
REACT_APP_BACKEND_URL=http://localhost:8080
