# LLM provider: openai | anthropic | gemini | groq (default: openai)
LLM_PROVIDER=openai

# Model override (optional, uses provider default if blank)
LLM_MODEL=

# API keys: provide the one matching your chosen LLM_PROVIDER
OPENAI_API_KEY=sk-proj-your-key-here
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: Serper.dev Google Search API key for real in-app search results.
# Without this, a faux-browser summary card is shown instead.
# Free tier: 2500 queries/month — https://serper.dev
SERPER_API_KEY=

# Backend
PORT=8080

# Frontend (copy to ui/.env.local for local dev)
VITE_BACKEND_URL=http://localhost:8080
